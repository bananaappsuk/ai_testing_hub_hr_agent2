# --- Required ---------------------------------------------------------------
OPENAI_API_KEY=

# --- Model ------------------------------------------------------------------
AGENT_MODEL=gpt-4o
# AGENT_TEMPERATURE=0

# --- Prompt -----------------------------------------------------------------
# Which system prompt to run. See PROMPT_VARIANTS in hr_agent/config.py.
# default      - grounded answers with section citations
# n8n_baseline - the original one-line n8n system message, for comparison
PROMPT_VARIANT=default

# --- Google ------------------------------------------------------------------
# Service account key with Viewer access to the policy doc.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
POLICY_DOC_ID=13Cp8y7uEapWBhrMW8AWa79aGek20MCtZchGZBW0_8ks
DOC_CACHE_SECONDS=300

# Optional: read the policy from a local file instead, skipping Google entirely.
# HR_POLICY_FILE=./hr_policy.md
